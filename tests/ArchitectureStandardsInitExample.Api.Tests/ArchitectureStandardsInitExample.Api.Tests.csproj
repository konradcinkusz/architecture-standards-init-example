<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P13 — test at the layer that has the logic. The test project mirrors the
    source tree, and isolation is by constructor: a fresh in-memory database per
    test class, so no test can see another's rows (TESTING-STRATEGY §5).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ArchitectureStandardsInitExample.Api/ArchitectureStandardsInitExample.Api.csproj" />
  </ItemGroup>

</Project>
