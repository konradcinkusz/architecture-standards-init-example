# Formatting is settled here, once, so no per-IDE formatting wars across a
# multi-project solution (REPO-BASELINE §1). Nothing downstream restates it.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{json,yml,yaml,toml,md,ts,tsx,js,jsx,mjs,cjs,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1}]
end_of_line = crlf

[*.{csproj,props,targets,config}]
indent_size = 2

[*.cs]
indent_size = 4

# --- C# language conventions -------------------------------------------------
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_new_line_before_open_brace = all

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

# Naming: interfaces begin with I; private fields are _camelCase.
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# CA1848 (LoggerMessage delegates) is real advice at high call volume and noise
# at this size; revisit if a hot path shows up in a profile.
dotnet_diagnostic.CA1848.severity = none

# --- Test projects -----------------------------------------------------------
# Test names are sentences: `List_clamps_an_absurd_limit_to_the_maximum_page_size`
# states one business goal, which is the per-test bar (TESTING-STRATEGY §6).
# CA1707 exists to keep underscores out of a public API surface; a test project
# has no public API surface.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# --- Generated code ----------------------------------------------------------
# EF Core writes these files and rewrites them on the next `dotnet ef migrations
# add`. Hand-editing them to satisfy a style rule is work that gets reverted by
# the tool, so the rules are turned off here rather than in a #pragma the
# generator will overwrite.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1825.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0300.severity = none
